# QuizFlow Backend — Local Development Configuration
PROJECT_NAME=QuizFlow
APP_VERSION=2.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Security (NEVER use this default in production!)
SECRET_KEY=quizflow_dev_secret_key_replace_in_production_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite (WAL mode enabled automatically for concurrent reads)
DATABASE_URL=sqlite:///./quizflow.db
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT_MS=15000
SQLITE_CACHE_SIZE_KB=32768

# Optional Redis Cache (Leave empty for local bounded LRU fallback)
REDIS_URL=
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=60
CACHE_QUIZ_LIST_TTL=60
CACHE_DASHBOARD_TTL=30
CACHE_LOCAL_MAX_ENTRIES=512

# Pagination & Rate Limiting
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_AUTH_RPM=60
RATE_LIMIT_ATTEMPT_RPM=1200

# Monitoring & Logging
METRICS_ENABLED=True
SLOW_QUERY_THRESHOLD_MS=100
LOG_FORMAT=text
LOG_LEVEL=INFO

# Initial Admin Bootstrap (Development convenience only)
FIRST_SUPERUSER_EMAIL=admin@quizflow.local
FIRST_SUPERUSER_PASSWORD=AdminSecurePass2026!
FIRST_SUPERUSER_NAME=QuizFlow System Admin

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006","http://localhost:8000","*"]
