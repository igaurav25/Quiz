# QuizFlow Backend — Production High-Concurrency Configuration Template
# Copy to .env and replace all placeholder secrets before deploying.
PROJECT_NAME=QuizFlow
APP_VERSION=2.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
DEBUG=False

# Security — Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_48_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database — PostgreSQL (Direct or via PgBouncer on port 6432)
DATABASE_URL=postgresql+psycopg2://quizflow:REPLACE_DB_PASSWORD@pgbouncer:6432/quizflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
# Set DB_USE_NULL_POOL=True if PgBouncer is in transaction pooling mode
DB_USE_NULL_POOL=False
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_SECONDS=0.15

# Redis — Distributed Cache, Rate Limiting & Celery Broker
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=60
CACHE_QUIZ_LIST_TTL=60
CACHE_DASHBOARD_TTL=30
REDIS_SOCKET_TIMEOUT=1.5

# Celery Background Workers
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
BACKGROUND_TASKS_ENABLED=True

# Pagination, Attempt Limits & Rate Limiting
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
ATTEMPT_GRACE_PERIOD_SECONDS=15
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_AUTH_RPM=60
RATE_LIMIT_ATTEMPT_RPM=1200
MAX_REQUEST_BODY_BYTES=10485760

# Monitoring & Structured JSON Logging
METRICS_ENABLED=True
SLOW_QUERY_THRESHOLD_MS=100
LOG_FORMAT=json
LOG_LEVEL=INFO

# Strict CORS Origins (List exact allowed frontend domains)
BACKEND_CORS_ORIGINS=["https://quizflow.example.com","https://admin.quizflow.example.com"]
